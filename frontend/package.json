{
    "name": "trinetra-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "build": {
        "appId": "com.trinetra.security",
        "productName": "TRINETRA",
        "extraMetadata": {
            "main": "electron/main.cjs"
        },
        "files": [
            "dist/**/*",
            "electron/**/*"
        ],
        "linux": {
            "target": [
                "AppImage"
            ],
